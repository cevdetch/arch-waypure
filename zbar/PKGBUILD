# Maintainer: cevdetch (https://github.com/cevdetch)
# Contributor: cevdetch

_pkgname=zbar
pkgname=${_pkgname}-waypure
pkgver=0.23.95
pkgrel=1
pkgdesc="Application and library for reading bar codes from various sources"
arch=('x86_64')
url="https://github.com/mchehab/zbar"
license=('LGPL-2.1-or-later')
depends=(
  dbus
  gdk-pixbuf2
  glib2
  glibc
  imagemagick
  libjpeg-turbo
  v4l-utils
)
makedepends=(
  docbook-xsl
  glib2-devel
  meson
  python
  xmlto
)
optdepends=(
  'gtk3: for zbar-gtk'
  'python: for zbar python bindings'
)
provides=("${_pkgname}" 'zbar-gtk' 'python-zbar')
conflicts=("${_pkgname}" 'zbar-gtk' 'python-zbar')
replaces=("${_pkgname}" 'zbar-gtk' 'python-zbar')
source=("${_pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('3bad3fe7b8764c6e2131cba91d40e22567a1365352914b62b55247b49124ed33')

build() {
  local _meson_options=(
    -D codes="ean,databar,code128,code93,code39,codabar,i25,qrcode,sqcode"
    -D library_type=shared
    -D static_executables=false
    -D pthread=true
    -D doc=true
    -D docdir=''
    -D video=true
    -D directshow=false
    -D xshm=disabled # WAYLAND
    -D xv=disabled # WAYLAND
    -D x11=disabled # WAYLAND
    -D dbus=enabled # ARCH
    -D dbusconfdir=/usr/share
    -D jpeg=enabled # ARCH
    -D imagemagick=enabled # ARCH
    -D graphicsmagick=disabled
    -D npapi=disabled
    -D gtk=gtk3 # ARCH
    -D gir=false # -ARCH
    -D python=python3 # ARCH
    # TODO: provide zbar-qt via Qt6: port qt/QZBarRenderer.cpp off QX11Info
    # (Qt5-only header, absent from Qt6) to QNativeInterface + non-X11
    # fallback; needs camera hardware to validate. Qt6 widget itself is
    # X-free (no X11Extras), configure already succeeds.
    -D qt=false # WAYLAND (Qt5 widget needs qt5-x11extras)
    -D qt6=false # ARCH
    -D java=disabled # ARCH
    -D build_tests=false # -ARCH
    -D nls=auto
  )

  arch-meson "${_pkgname}-${pkgver}" build "${_meson_options[@]}"

  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}
