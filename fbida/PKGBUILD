# Maintainer: cevdetch (https://github.com/cevdetch)

_pkgname=fbida
pkgname=${_pkgname}-waypure
pkgver=2.14
pkgrel=1
pkgdesc='Framebuffer/DRM image and PDF viewers and lossless JPEG transformations'
arch=('x86_64')
url='https://www.kraxel.org/blog/linux/fbida/'
license=('GPL-2.0-only')
depends=('fontconfig' 'freetype2' 'giflib' 'glibc' 'libdrm' 'libepoxy' 'libexif'
         'libjpeg-turbo' 'libpng' 'libtiff' 'libwebp' 'mesa' 'pixman' 'poppler-glib')
optdepends=('ghostscript: render PostScript files with fbgs')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
source=("https://www.kraxel.org/releases/${_pkgname}/${_pkgname}-${pkgver}.tar.gz"{,.asc}
        'fbida-gcc10.patch::https://gitlab.com/kraxel/fbida/-/commit/1bb8a8aa.patch')
sha256sums=('95b7c01556cb6ef9819f358b314ddfeb8a4cbe862b521a3ed62f03d163154438'
            '7ea027fb1470106acb92582e74c4f0f8e2e4eb06128801604ddd657f7f2b85fd'
            '3a76829dba124b542631cb3d78da6414a339e1cbb3bf5c6451d677f51bcf3c76')
validpgpkeys=('A0328CFFB93A17A79901FE7D4CB6D8EED3E87138')

prepare() {
  cd "${_pkgname}-${pkgver}"
  patch -Np1 -i ../fbida-gcc10.patch
}

build() {
  cd "${_pkgname}-${pkgver}"
  # The bundled libjpeg headers need prototypes enabled for C23.
  export CFLAGS="${CFLAGS} -DHAVE_PROTOTYPES"
  local _make_options=(
    prefix=/usr
    verbose=yes
    HAVE_MOTIF=no # WAYLAND
    HAVE_LIBGIF=yes
    HAVE_LIBWEBP=yes
  )
  make "${_make_options[@]}"
}

package() {
  cd "${_pkgname}-${pkgver}"
  make prefix=/usr HAVE_MOTIF=no HAVE_LIBGIF=yes HAVE_LIBWEBP=yes \
    STRIP= DESTDIR="${pkgdir}" install
}
