source=("${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}.tar.xz")
sha256sums=('45ea0ef3c2b93b754e33763a1074673ab380e088d8217c28be3779423f56fe48')

build() {
  local _meson_options=(
    # Upstream's -rdynamic default overrides LDFLAGS.
    -D cpp_link_args="${LDFLAGS} -rdynamic"

    -D all_deprecated_warnings=false # show all deprecated declaration warnings, including intentionally retained APIs
    -D archive=enabled # archive files e.g. zip, gz
    -D cms=enabled # color management system
    -D doxygen=disabled
    -D djvu=enabled # djvu
    -D execinfo=enabled # execinfo.h
    -D exiv2=enabled # exiv2
    -D exr=enabled # exr
    -D deprecated_warnings=false # show deprecated declaration warnings
    -D fd_verbose_debug=disabled # verbose filedata debugging
    -D fits=enabled # fits
    -D git=disabled
    -D gps_map=enabled # gps map
    -D heif=enabled # heif
    -D help_pdf=disabled
    -D j2k=enabled # j2k
    -D jpeg=enabled # jpeg
    -D jpegxl=enabled # jpegxl
    -D libraw=enabled # libraw
    -D lua=enabled # lua
    -D npy=enabled # npy
    -D pandoc=enabled # README.html
    -D pdf=enabled # pdf
    -D spell=enabled # spelling checks
    -D tiff=enabled # tiff
    -D unit_tests=disabled # unit tests
    -D videometadata=enabled # video GPS metadata (requires Exiv2 and FFmpeg)
    -D videothumbnailer=enabled # video thumbnailer
    -D webp=enabled # webp
    -D yelp_build=enabled # help files
  )

  arch-meson "${_pkgname}-${pkgver}" build "${_meson_options[@]}"

  meson compile -C build
}

check() (
  export XDG_RUNTIME_DIR
  XDG_RUNTIME_DIR=$(mktemp -d)
  unset DISPLAY WAYLAND_DISPLAY SWAYSOCK DBUS_SESSION_BUS_ADDRESS

  printf 'swaybg_command -\n' > "${XDG_RUNTIME_DIR}/sway.conf"
  WLR_BACKENDS=headless WLR_RENDERER=pixman sway -c "${XDG_RUNTIME_DIR}/sway.conf" > build/sway-test.log 2>&1 &
  local _sway_pid=$!
  trap 'kill "${_sway_pid}" 2>/dev/null || :; wait "${_sway_pid}" 2>/dev/null || :; rm -rf -- "${XDG_RUNTIME_DIR}"' EXIT

  local _attempt _socket
  for _attempt in {1..100}; do
    kill -0 "${_sway_pid}" 2>/dev/null || break
    for _socket in "${XDG_RUNTIME_DIR}"/wayland-*; do
      if [[ -S ${_socket} ]]; then
        export WAYLAND_DISPLAY=${_socket##*/}
        break 2
      fi
    done
    sleep 0.05
  done
  if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    cat build/sway-test.log >&2
    return 1
  fi

  GDK_BACKEND=wayland GSK_RENDERER=cairo GIO_USE_VFS=local \
    meson test -C build --print-errorlogs
)

package() {
  DESTDIR="${pkgdir}" meson install -C build
  # add missing html doc
  cp -a --no-preserve=ownership build/doc/html "${pkgdir}/usr/share/doc/${_pkgname}/"
}
