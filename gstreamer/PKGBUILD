package_gst-plugins-base-waypure() {
  pkgdesc+=" - base plugins"
  depends=(
    "gst-plugins-base-libs-waypure=${pkgver}-${pkgrel}"
    "gstreamer-waypure=${pkgver}-${pkgrel}"
    alsa-lib
    cairo
    cdparanoia
    glib2
    glibc
    libgcc
    libogg
    libtheora
    libvorbis
    opus
    pango
  )

  _set_relations gst-plugins-base
  cd root
  local files=(
    usr/lib/gstreamer-1.0/libgstalsa.so
    usr/lib/gstreamer-1.0/libgstcdparanoia.so
    usr/lib/gstreamer-1.0/libgstogg.so
