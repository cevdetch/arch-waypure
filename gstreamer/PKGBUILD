prepare() {
  cd "${_pkgbase}-${pkgver}"

  patch -Np1 -i ../0001-HACK-meson-Disable-broken-tests.patch
  patch -Np1 -i ../0002-faac-support-faac-2.0-faac_-API.patch
  patch -Np1 -i ../0003-synaescope-handle-empty-bins.patch
}

build() {
  local _meson_options=(
    -D base=enabled
    -D good=enabled
    -D ugly=enabled
    -D bad=enabled
    -D libav=enabled
    -D devtools=disabled
    -D ges=disabled
    -D rtsp_server=disabled
    -D rs=disabled
    -D python=disabled
    -D sharp=disabled
    -D qt5=disabled
    -D qt6=disabled
    -D gst-examples=disabled
    -D libnice=disabled
    -D orc-source=system
    -D gpl=enabled
    -D package-name="Waypure GStreamer ${pkgver}-${pkgrel}"
    -D package-origin="https://github.com/cevdetch/arch-waypure"
    -D benchmarks=disabled
    -D examples=disabled
    -D glib_debug=disabled
    -D tests=enabled
    -D introspection=enabled
    -D nls=enabled
    -D doc=disabled
    -D gtk_doc=disabled
    -D gstreamer:dbghelp=disabled
    -D gstreamer:ptp-helper-permissions=capabilities

    -D gst-plugins-base:gl=enabled
    -D gst-plugins-base:gl_api=opengl,gles2
    -D gst-plugins-base:gl_platform=egl
    -D gst-plugins-base:opengl_module_name=libOpenGL.so.0
    -D gst-plugins-base:gl_winsys=wayland,egl,gbm,surfaceless
    -D gst-plugins-base:x11=disabled
    -D gst-plugins-base:xshm=disabled
    -D gst-plugins-base:xvideo=disabled
    -D gst-plugins-base:xi=disabled
    -D gst-plugins-base:libvisual=disabled
    -D gst-plugins-base:tremor=disabled

    -D gst-plugins-good:ximagesrc=disabled
    -D gst-plugins-good:ximagesrc-xshm=disabled
    -D gst-plugins-good:ximagesrc-xfixes=disabled
    -D gst-plugins-good:ximagesrc-xdamage=disabled
    -D gst-plugins-good:ximagesrc-navigation=disabled
    -D gst-plugins-good:jack=disabled
    -D gst-plugins-good:oss=disabled
    -D gst-plugins-good:oss4=disabled
    -D gst-plugins-good:aalib=disabled
    -D gst-plugins-good:libcaca=disabled
    -D gst-plugins-good:gtk3=disabled
    -D gst-plugins-good:qt-x11=disabled
    -D gst-plugins-good:rpicamsrc=disabled

    -D gst-plugins-bad:gl=enabled
    -D gst-plugins-bad:wayland=enabled
    -D gst-plugins-bad:x11=disabled
    -D gst-plugins-bad:vulkan=enabled
    -D gst-plugins-bad:vulkan-video=enabled
    -D gst-plugins-bad:vulkan-windowing=wayland
    -D gst-plugins-bad:va=enabled
    -D gst-plugins-bad:svthevcenc=enabled
    -D gst-plugins-bad:gtk3=disabled
    -D gst-plugins-bad:wpe=disabled
    -D gst-plugins-bad:wpe2=disabled
    -D gst-plugins-bad:opencv=disabled
    -D gst-plugins-bad:onnx=disabled
    -D gst-plugins-bad:hip=disabled
    -D gst-plugins-bad:msdk=disabled
    -D gst-plugins-bad:qsv=disabled
    -D gst-plugins-bad:fbdev=disabled
    -D gst-plugins-bad:openal=disabled
    -D gst-plugins-bad:aja=disabled
    -D gst-plugins-bad:amfcodec=disabled
    -D gst-plugins-bad:androidmedia=disabled
    -D gst-plugins-bad:cuda-nvmm=disabled
    -D gst-plugins-bad:directfb=disabled
    -D gst-plugins-bad:directshow=disabled
    -D gst-plugins-bad:flite=disabled
    -D gst-plugins-bad:gs=disabled
    -D gst-plugins-bad:iqa=disabled
    -D gst-plugins-bad:isac=disabled
    -D gst-plugins-bad:lcevcdecoder=disabled
    -D gst-plugins-bad:lcevcencoder=disabled
    -D gst-plugins-bad:magicleap=disabled
    -D gst-plugins-bad:mpeghdec=disabled
    -D gst-plugins-bad:nvcomp=disabled
    -D gst-plugins-bad:nvdswrapper=disabled
    -D gst-plugins-bad:openni2=disabled
    -D gst-plugins-bad:opensles=disabled
    -D gst-plugins-bad:qt6d3d11=disabled
    -D gst-plugins-bad:svtjpegxs=disabled
    -D gst-plugins-bad:tflite=disabled
    -D gst-plugins-bad:tinyalsa=disabled
    -D gst-plugins-bad:voaacenc=disabled
    -D gst-plugins-bad:voamrwbenc=disabled
    -D gst-plugins-bad:wasapi2=disabled
    -D gst-plugins-bad:wasapi=disabled
    -D gst-plugins-ugly:sidplay=disabled
    -D gst-plugins-ugly:mpeg2dec=disabled
  )

  export GI_SCANNER_DISABLE_CACHE=1

  arch-meson "${_pkgbase}-${pkgver}" build "${_meson_options[@]}"
  meson compile -C build -j "${NPROC:-$(nproc)}"
}

check() (
  unset DISPLAY WAYLAND_DISPLAY
  export XDG_RUNTIME_DIR="$PWD/runtime-dir"
  mkdir -p -m 700 "$XDG_RUNTIME_DIR"

  export CK_TIMEOUT_MULTIPLIER=5
  export NO_AT_BRIDGE=1 GTK_A11Y=none
  export GST_GL_WINDOW=surfaceless GST_GL_PLATFORM=egl LIBGL_ALWAYS_SOFTWARE=1
  export VK_LOADER_DRIVERS_SELECT='*lvp*'

  meson test -C build --no-rebuild --print-errorlogs \
    --num-processes "${NPROC:-$(nproc)}" -t "$CK_TIMEOUT_MULTIPLIER"
)

_install() {
  local src dir
  for src in "${files[@]}"; do
    dir="$pkgdir/$(dirname "$src")"
    mkdir -p "$dir"
    mv -v "$src" "$dir"
  done
}

_set_relations() {
  provides=("${1}=${pkgver}")
  conflicts=("$1")
}

package_gstreamer-waypure() {
  pkgdesc+=" - core"
  depends=(
    glib2
    glibc
    libcap
    libelf
    libgcc
    libunwind
  )
  optdepends=(
    "python: gst-plugins-doc-cache-generator"
    "gst-plugin-pipewire: native PipeWire audio and video source/sink"
  )
  _set_relations gstreamer
  install=gstreamer.install

  meson install -C build --no-rebuild --destdir "$srcdir/root"

  cd root
  local files=(
    usr/include/gstreamer-1.0/gst/{base,check,controller,net,*.h}
    usr/lib/libgst{reamer,base,check,controller,net}-1.0.so*
    usr/lib/pkgconfig/gstreamer{,-base,-check,-controller,-net}-1.0.pc
    usr/lib/girepository-1.0/Gst{,Base,Check,Controller,Net}-1.0.typelib
    usr/share/gir-1.0/Gst{,Base,Check,Controller,Net}-1.0.gir

    usr/lib/gstreamer-1.0/gst-{completion,ptp}-helper
    usr/lib/gstreamer-1.0/gst-{hotdoc-plugins,plugin}-scanner
    usr/lib/gstreamer-1.0/gst-plugins-doc-cache-generator
    usr/lib/gstreamer-1.0/libgstcoreelements.so
    usr/lib/gstreamer-1.0/libgstcoretracers.so

    usr/share/locale/*/LC_MESSAGES/gstreamer-1.0.mo

    usr/bin/gst-{inspect,launch,stats,tester,typefind}-1.0
    usr/share/man/man1/gst-{inspect,launch,stats,typefind}-1.0.1

    usr/share/bash-completion/completions/gst-{inspect,launch}-1.0
    usr/share/bash-completion/helpers/gst

    usr/share/gdb/auto-load/usr/lib/libgstreamer-1.0.so*.py
    usr/share/gstreamer-1.0/gdb/glib_gobject_helper.py
    usr/share/gstreamer-1.0/gdb/gst_gdb.py

    usr/share/aclocal/gst-element-check-1.0.m4
    usr/share/cmake/FindGStreamer.cmake
  ); _install
}

