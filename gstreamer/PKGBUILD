package_gst-plugin-va-waypure() {
  pkgdesc+=" - va plugin"
  depends=(
    "gst-plugins-bad-libs-waypure=${pkgver}-${pkgrel}"
    "gst-plugins-base-libs-waypure=${pkgver}-${pkgrel}"
    "gstreamer-waypure=${pkgver}-${pkgrel}"
    glib2
    glibc
    libgudev
    libva
  )
  _set_relations gst-plugin-va
  replaces=('gstreamer-vaapi<=1.26.10-5')

  cd root
  local files=(
    usr/lib/gstreamer-1.0/libgstva.so
  ); _install
}
