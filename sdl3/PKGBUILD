# Maintainer: cevdetch (https://github.com/cevdetch)
# Contributor: cevdetch

_pkgname=sdl3
pkgname=${_pkgname}-waypure
pkgver=3.4.18
pkgrel=1
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 3)"
arch=('x86_64')
url="https://github.com/libsdl-org/SDL"
license=('Zlib')
depends=('glibc' 'libglvnd' 'libusb' 'libpipewire' 'libxkbcommon' 'wayland' 'systemd-libs')
makedepends=('cmake' 'dbus' 'liburing' 'ninja' 'vulkan-headers')
optdepends=(
  'dbus: desktop integration and Fcitx input support'
  'gtk3: GTK file dialogs and tray support'
  'libayatana-appindicator: tray icons'
  'liburing: asynchronous I/O acceleration'
  'pipewire: PipeWire audio and camera services'
  'vulkan-icd-loader: Vulkan loader'
  'vulkan-driver: Vulkan rendering'
)
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("${url}/releases/download/release-${pkgver}/SDL3-${pkgver}.tar.gz")
sha256sums=('9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3')

prepare() {
  rm -r "SDL3-${pkgver}/src/video/khronos"
  ln -s /usr/include "SDL3-${pkgver}/src/video/khronos"
}

build() {
  local _cmake_options=(
    -B build -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr

    -DSDL_ASSERTIONS=disabled
    -DSDL_SHARED=ON
    -DSDL_STATIC=OFF
    -DSDL_DEPS_SHARED=OFF # link rather than dlopen() where possible
    -DSDL_RPATH=OFF

    -DSDL_AUDIO=ON
    -DSDL_VIDEO=ON
    -DSDL_RENDER=ON

    -DSDL_DLOPEN_NOTES=OFF
    -DSDL_LIBC=ON
    -DSDL_SYSTEM_ICONV=ON
    -DSDL_LIBICONV=OFF
    -DSDL_GCC_ATOMICS=ON
    -DSDL_DBUS=ON
    -DSDL_LIBURING=ON
    -DSDL_DISKAUDIO=OFF
    -DSDL_DUMMYAUDIO=OFF
    -DSDL_DUMMYCAMERA=OFF
    -DSDL_DUMMYVIDEO=OFF
    -DSDL_PTHREADS=ON
    -DSDL_PTHREADS_SEM=ON
    -DSDL_CLOCK_GETTIME=ON
    -DSDL_BACKGROUNDING_SIGNAL=OFF
    -DSDL_FOREGROUNDING_SIGNAL=OFF

    # Audio
    -DSDL_OSS=OFF
    -DSDL_ALSA=OFF
    -DSDL_JACK=OFF
    -DSDL_PIPEWIRE=ON
    -DSDL_PULSEAUDIO=OFF
    -DSDL_SNDIO=OFF

    # Input
    -DSDL_HIDAPI=ON
    -DSDL_HIDAPI_LIBUSB=ON
    -DSDL_LIBUDEV=ON
    -DSDL_IBUS=OFF

    # Video
    -DSDL_X11=OFF
    -DSDL_FRIBIDI=OFF
    -DSDL_LIBTHAI=OFF
    -DSDL_WAYLAND=ON
    -DSDL_WAYLAND_LIBDECOR=OFF
    -DSDL_RENDER_GPU=OFF
    -DSDL_VULKAN=ON
    -DSDL_RENDER_VULKAN=ON
    -DSDL_OPENVR=OFF
    -DSDL_KMSDRM=OFF
    -DSDL_OFFSCREEN=OFF
    -DSDL_TRAY=ON
    -DSDL_OPENGL=OFF
    -DSDL_OPENGLES=OFF

    # Build options
    -DSDL_ASAN=OFF
    -DSDL_CCACHE=OFF
    -DSDL_CLANG_TIDY=OFF
    -DSDL_TEST_LIBRARY=OFF
    -DSDL_TESTS=OFF
    -DSDL_INSTALL_TESTS=OFF
    -DSDL_EXAMPLES=OFF
  )

  cmake -S "SDL3-$pkgver" "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "SDL3-${pkgver}/LICENSE.txt" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
