Subject: [PATCH] Use GLVND OpenGL consistently in Linux builds without GLX

Based on Haelwenn (lanodan) Monnier's OpenGL fallback patch:
https://github.com/anholt/libepoxy/pull/259

Linux builds without GLX must use OpenGL metadata even when gl.pc is present,
and resolve desktop GL through libOpenGL without first loading legacy libGL.
Keep the existing behavior for GLX-enabled builds and other platforms.

--- a/meson.build
+++ b/meson.build
@@ -166,3 +166,10 @@
 dl_dep = cc.find_library('dl', required: false)
-gl_dep = dependency('gl', required: false)
+if host_system == 'linux' and not build_glx
+  gl_dep = dependency('opengl', required: true)
+else
+  gl_dep = dependency('gl', required: false)
+  if not gl_dep.found() and not build_glx
+    gl_dep = dependency('opengl', required: false)
+  endif
+endif
 egl_dep = dependency('egl', required: false)
--- a/src/meson.build
+++ b/src/meson.build
@@ -101,3 +101,3 @@
 if gl_dep.found() and gl_dep.type_name() == 'pkgconfig'
-  gl_reqs += 'gl'
+  gl_reqs += gl_dep.name()
 endif
--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -669 +669,2 @@
-#if defined(_WIN32) || defined(__APPLE__)
+#if defined(_WIN32) || defined(__APPLE__) || \
+    (defined(__linux__) && !PLATFORM_HAS_GLX && defined(OPENGL_LIB))
