# Maintainer: cevdetch (https://github.com/cevdetch)
# Contributor: cevdetch

_pkgname=libpulse
pkgname=${_pkgname}-waypure
pkgver=17.0+r134+g77d25a1e6
pkgrel=1
pkgdesc="A featureful, general-purpose sound server (client library)"
arch=('x86_64')
url="https://www.freedesktop.org/wiki/Software/PulseAudio/"
license=('LGPL-2.1-or-later')
depends=(
  bash
  dbus
  glib2
  glibc
  libasyncns
  libsndfile
  systemd-libs
)
makedepends=(
  git
  meson
  perl
  perl-xml-parser
)
checkdepends=('libxml2')
optdepends=(
  'pipewire-pulse: PulseAudio backend via PipeWire'
)
provides=(
  "${_pkgname}=${pkgver}"
  libpulse.so
  libpulse-simple.so
  libpulse-mainloop-glib.so
)
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
backup=('etc/pulse/client.conf')
_commit=77d25a1e613095bdf87a1d13b65e7c330565077a # master, same as Arch
source=(
  "git+https://gitlab.freedesktop.org/pulseaudio/pulseaudio.git#commit=$_commit"
)
sha256sums=('3b0b49712a7f8c27b00648499e95ed9703614ea291035c951ac4a04521c74dff')

pkgver() {
  cd pulseaudio
  git describe --tags | sed 's/^v//;s/[^-]*-g/r&/;s/-/+/g'
}

prepare() {
  cd pulseaudio

  # Freeze version before patching (same as Arch, keeps pkgver() stable)
  ./git-version-gen doesnt-exist >.tarball-version
}

build() {
  local _meson_options=(
    -D daemon=false
    -D client=true
    -D doxygen=disabled
    -D gcov=false
    -D man=true
    -D tests=disabled

    -D pulsedsp-location="/usr/\$LIB/pulseaudio"
    -D modlibexecdir="/usr/\$LIB/pulseaudio/modules"

    -D alsa=disabled
    -D asyncns=enabled
    -D dbus=enabled
    -D fftw=disabled
    -D glib=enabled
    -D gstreamer=disabled
    -D gtk=disabled
    -D ipv6=true
    -D jack=disabled
    # Keep padsp and libpulsedsp for OSS applications using PulseAudio.
    -D oss-output=enabled
    -D systemd=enabled
    -D valgrind=disabled
    -D x11=disabled
  )

  arch-meson pulseaudio build "${_meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
  install -Dm644 pulseaudio/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"

  # Point clients at pipewire-pulse instead of spawning pulseaudio.
  # Arch applies this sed in package_pulseaudio(); Gentoo does it in src_prepare.
  sed -e '/autospawn/iautospawn = no' -i "${pkgdir}/etc/pulse/client.conf"

  # Upstream installs pa-info with any client=true build (src/utils/meson.build).
  # Arch splits it into the daemon package and Fedora rms it with daemon off.
  # Remove it here.
  rm -f "${pkgdir}/usr/bin/pa-info"

  # Upstream adds pactl->pulseaudio/pacmd/pasuspender completions with daemon=true
  # (shell-completion/bash/meson.build). Arch splits the pulseaudio one into
  # libpulse and Gentoo re-adds them with bashcomp_alias. Recreate that link.
  local _compdir="${pkgdir}/usr/share/bash-completion/completions"
  if [[ -f "${_compdir}/pactl" ]]; then
    ln -sf pactl "${_compdir}/pulseaudio"
  fi

  # daemon=false installs no modules; drop the dir when meson leaves it behind.
  if [[ -d "${pkgdir}/usr/lib/pulseaudio/modules" ]]; then
    rmdir --ignore-fail-on-non-empty "${pkgdir}/usr/lib/pulseaudio/modules" || true
  fi

  # Arch splits locale into the daemon package.
  rm -rf "${pkgdir}/usr/share/locale"
}
