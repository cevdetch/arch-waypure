check() {
  local _libraries=("${srcdir}/FFmpeg-n${pkgver}"/lib{avcodec,avdevice,avfilter,avformat,avutil,swresample,swscale})
  local _library_path
  printf -v _library_path '%s:' "${_libraries[@]}"

  local _zlib_tests=()
  # WORKAROUND: https://bugs.gentoo.org/965737 (zlib-ng compression is not bit-exact with zlib).
  if grep -q '^#define ZLIBNG_VERSION ' "$(pkg-config --variable=includedir zlib)/zlib.h"; then
    _zlib_tests=(
      lavf-{apng{,.png},gray16be.png,pdv{,-intra},png,rgb48be.png}
      mov-mp4-frag-flush seek-lavf-pdv
      vsynth{1,2,3}-{flashsv,mpng,zlib}
    )
  fi
  LD_LIBRARY_PATH="${_library_path%:}" make -C "FFmpeg-n${pkgver}" fate IGNORE_TESTS="${_zlib_tests[*]}"
}

package() {
  make DESTDIR="${pkgdir}" -C "FFmpeg-n${pkgver}" install install-man
}
