    --disable-libmysofa
    --disable-ohcodec
    --enable-opencl
    --disable-opengl # MINIMAL
    --disable-openssl
    --disable-pocketsphinx
    --disable-sndio # PIPEWIRE
    --disable-schannel
    --enable-sdl2
    --disable-securetransport
    --enable-vapoursynth
    --disable-whisper
