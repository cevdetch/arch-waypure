prepare() {
  cd "FFmpeg-n${pkgver}"

  patch -Np1 -i ../0001-Add-av_stream_get_first_dts-for-Chromium.patch
  patch -Np1 -i ../0001-ffmpeg-6.1-opencl-parallel-gmake-fix.patch
}

build() {
  cd "FFmpeg-n${pkgver}"

  local _make_options=(
