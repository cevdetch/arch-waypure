    --disable-libuavs3d
    --enable-libv4l2
    --enable-libvidstab
    --enable-libvmaf
    --enable-libvorbis
    --enable-libvpx
    --disable-libvvenc
    --enable-libwebp
    --enable-libx264
    --enable-libx265
    --disable-libxeve
    --disable-libxevd
    --disable-libxavs
    --disable-libxavs2
    --disable-libxcb # WAYLAND
    --enable-libxvid
    --enable-libxml2
    --enable-libzimg
    --enable-libzmq
    --disable-libzvbi
    --disable-decklink
    --disable-mbedtls
    --disable-mediacodec
