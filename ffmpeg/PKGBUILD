    --enable-shared
    --disable-small
    --enable-swscale-alpha

    # Program options
    --enable-ffmpeg
    --enable-ffplay
    --enable-ffprobe

    # Documentation options
    --disable-htmlpages
    --enable-manpages
    --disable-podpages
    --disable-txtpages

    # Component options
    --enable-avdevice
    --enable-avcodec
    --enable-avformat
    --enable-swresample
    --enable-swscale
    --enable-avfilter
    --enable-pthreads
    --disable-w32threads
    --disable-os2threads

    # External library support
    --disable-alsa # PIPEWIRE
    --disable-appkit
    --disable-avfoundation
    --enable-avisynth
    --enable-bzlib
    --enable-cairo
    --disable-coreimage
    --enable-frei0r
    --disable-gcrypt
    --enable-gmp
    --enable-gnutls
    --enable-iconv
    --enable-ladspa
    --enable-lcms2
    --enable-libaom
