Use GLVND OpenGL/EGL for Qt6 contexts and OpenCL sharing.
Keep platform and device indices distinct when selecting a shared OpenCL device.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -261,6 +261,9 @@
 OCV_OPTION(WITH_OPENEXR "Include ILM support via OpenEXR" (WIN32 OR ANDROID OR APPLE) OR NOT CMAKE_CROSSCOMPILING
   VISIBLE_IF NOT APPLE_FRAMEWORK AND NOT WINRT
   VERIFY HAVE_OPENEXR)
+OCV_OPTION(WITH_EGL "Use EGL for OpenGL contexts" OFF
+  VISIBLE_IF UNIX AND NOT APPLE
+  VERIFY HAVE_EGL)
 OCV_OPTION(WITH_OPENGL "Include OpenGL support" OFF
   VISIBLE_IF NOT ANDROID AND NOT WINRT
   VERIFY HAVE_OPENGL)
--- a/cmake/OpenCVFindLibsGUI.cmake
+++ b/cmake/OpenCVFindLibsGUI.cmake
@@ -64,7 +64,16 @@
