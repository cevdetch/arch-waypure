-    find_package (OpenGL QUIET)
+    if(WITH_EGL)
+      find_package(OpenGL QUIET COMPONENTS OpenGL EGL)
+      if(NOT TARGET OpenGL::OpenGL OR NOT TARGET OpenGL::EGL)
+        message(FATAL_ERROR "EGL OpenGL support requires GLVND OpenGL and EGL")
+      endif()
+      set(OPENGL_LIBRARIES OpenGL::OpenGL OpenGL::EGL)
+      set(HAVE_EGL TRUE)
+    else()
+      find_package(OpenGL QUIET)
+    endif()
