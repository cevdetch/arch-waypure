index b322d98d72ec..689a5517d938 100644
--- a/samples/opengl/CMakeLists.txt
+++ b/samples/opengl/CMakeLists.txt
@@ -14,6 +14,7 @@ SET(OPENCV_OPENGL_SAMPLES_REQUIRED_DEPS
   opencv_imgproc
   opencv_imgcodecs
