prepare() {
  patch -d "opencv-${pkgver}" -Np1 -i "${srcdir}/sample-ptcloud.patch"
  patch -d "opencv-${pkgver}" -Np1 -i "${srcdir}/fix-dnn-umat-dimensions.patch"
  patch -d "opencv-${pkgver}" -Np1 -i "${srcdir}/ffmpeg-9.patch"
  patch -d "opencv-${pkgver}" -Np1 -i "${srcdir}/0001-Use-EGL-for-OpenGL-contexts.patch"
  patch -d "opencv_contrib-${pkgver}" -Np1 -i "${srcdir}/0002-Use-core-framebuffer-functions-with-EGL.patch"
  patch -d "opencv-${pkgver}" -Np1 -i "${srcdir}/0003-Link-EGL-examples-with-GLU.patch"

  # OpenCV verifies its own MD5s after makepkg verifies these source SHA256s.
  local _id _file _hash
  for _id in xfeatures2d/boostdesc xfeatures2d/vgg wechat_qrcode data ade unifont; do
    case ${_id} in
      xfeatures2d/boostdesc) local _files=(opencv_3rdparty-34e4206aef44d50e6bbcd0ab06354b52e7466d26/*.i) ;;
      xfeatures2d/vgg) local _files=(opencv_3rdparty-fccf7cd6a4b12079f73bbfb21745f9babcd4eb1d/*.i) ;;
      wechat_qrcode) local _files=(opencv_3rdparty-a8b69ccc738421293254aec5ddb38bd523503252/*.{caffemodel,prototxt}) ;;
      data) local _files=(face_landmark_model.dat) ;;
      ade) local _files=(ade-v0.1.2e.zip) ;;
      unifont) local _files=(WenQuanYiMicroHei.ttf.gz) ;;
    esac
    for _file in "${_files[@]}"; do
      read -r _hash _ < <(md5sum "${_file}")
      local _filename=${_file##*/}
      [[ ${_id} == ade ]] && _filename=v0.1.2e.zip
      install -Dm644 "${_file}" "${srcdir}/.opencv-cache/${_id}/${_hash}-${_filename}"
    done
  done
}

build() {
  export JAVA_HOME=/usr/lib/jvm/default
  local _cmake_options=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_DISABLE_FIND_PACKAGE_X11=ON
    -DWITH_QT=6
    -DWITH_EGL=ON
    -DWITH_OPENGL=ON
    -DOpenGL_GL_PREFERENCE=GLVND
    -DWITH_GTK=OFF
    -DWITH_WAYLAND=OFF
    -DWITH_VTK=OFF
    -DBUILD_opencv_viz=OFF
    -DWITH_CUDA=OFF
    -DWITH_CUDNN=OFF
    -DWITH_IPP=OFF
    -DWITH_OPENCL=ON
    -DWITH_TBB=ON
    -DWITH_VULKAN=ON
    -DVULKAN_INCLUDE_DIRS=/usr/include
    -DWITH_JPEGXL=ON
    -DWITH_FFMPEG=ON
    -DWITH_GSTREAMER=ON
    -DWITH_UNIFONT=ON
    -DBUILD_opencv_python3=ON
    -DBUILD_opencv_java=ON
    -DBUILD_TESTS=OFF
    -DBUILD_PERF_TESTS=OFF
    -DBUILD_EXAMPLES=ON
    -DINSTALL_C_EXAMPLES=ON
    -DINSTALL_PYTHON_EXAMPLES=ON
    -DOPENCV_EXTRA_MODULES_PATH="${srcdir}/opencv_contrib-${pkgver}/modules"
    -DOPENCV_DOWNLOAD_PATH="${srcdir}/.opencv-cache"
    -DOPENCV_DOWNLOAD_TRIES_LIST=
    -DOPENCV_SKIP_PYTHON_LOADER=ON
    -DLAPACK_LIBRARIES='/usr/lib/liblapack.so;/usr/lib/libblas.so;/usr/lib/libcblas.so'
    -DLAPACK_CBLAS_H=/usr/include/cblas.h
    -DLAPACK_LAPACKE_H=/usr/include/lapacke.h
    -DOPENCV_GENERATE_PKGCONFIG=ON
    -DOPENCV_ENABLE_NONFREE=ON
    -DOPENCV_JNI_INSTALL_PATH=lib
    -DOPENCV_GENERATE_SETUPVARS=OFF
    -DEIGEN_INCLUDE_PATH=/usr/include/eigen3
    -Dprotobuf_MODULE_COMPATIBLE=ON
    -DHDF5_NO_FIND_PACKAGE_CONFIG_FILE=ON
    -DCPU_BASELINE_DISABLE=SSE3
    -DCPU_BASELINE_REQUIRE=SSE2
  )
  cmake -S "opencv-${pkgver}" -B build "${_cmake_options[@]}"
  [[ ! -s build/download_with_curl.sh ]]
  grep -q '^#define HAVE_EGL' build/cvconfig.h
  grep -q '^#define HAVE_OPENGL' build/cvconfig.h
  cmake --build build --parallel "${NPROC:-$(nproc)}"
}

package_opencv-waypure() {
  provides=("opencv=${pkgver}")
  conflicts=('opencv')
  DESTDIR="${pkgdir}" cmake --install build
  mv "${pkgdir}/usr/share/opencv5/samples" "${srcdir}"
  ln -sr "${pkgdir}"/usr/share/java/{opencv5/opencv-${pkgver//./},opencv}.jar
  ln -sr "${pkgdir}"/usr/lib/{libopencv_java${pkgver//./},libopencv_java}.so
  rm -r "${pkgdir}"/usr/lib/python3*
}

package_opencv-samples-waypure() {
  pkgdesc='OpenCV samples'
  arch=('any')
  depends=("opencv-waypure=${pkgver}-${pkgrel}")
  provides=("opencv-samples=${pkgver}")
  conflicts=('opencv-samples')
  optdepends=('python: Python examples'
              'python-opencv: OpenCV bindings for Python examples'
              'python-numpy: numerical arrays for Python examples'
              'python-matplotlib: plotting for selected Python examples')
  install -dm755 "${pkgdir}/usr/share/opencv5"
  mv samples "${pkgdir}/usr/share/opencv5"
}

package_python-opencv-waypure() {
  pkgdesc='Python bindings for OpenCV'
  depends=('fmt' 'glibc' 'hdf5' 'jsoncpp' 'libgcc' 'libstdc++'
           "opencv-waypure=${pkgver}-${pkgrel}" 'openmpi' 'pugixml'
           'python-numpy' 'qt6-base')
  provides=("python-opencv=${pkgver}")
  conflicts=('python-opencv')
  unset optdepends
  DESTDIR="${pkgdir}" cmake --install build/modules/python3
}
