# Maintainer: cevdetch (https://github.com/cevdetch)
# Contributor: cevdetch

_pkgname=libwmf
pkgname=${_pkgname}-waypure
pkgver=0.2.17
pkgrel=1
pkgdesc="A library for reading vector images in Microsoft's native Windows Metafile Format (WMF)"
arch=('x86_64')
url="https://github.com/caolanm/libwmf"
license=('LGPL-2.1-or-later')
depends=(
  bash
  expat
  freetype2
  glib2
  glibc
  libjpeg-turbo
  libpng
  zlib
)
makedepends=('gdk-pixbuf2')
optdepends=('gdk-pixbuf2: for pixbuf loader')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=(
  "${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}.tar.gz"
  'libwmf-0.2.8.4-libpng-1.5.patch'
  'libwmf-0.2.8.4-pngfix.patch'
)
sha256sums=('876915024b64edda8d417daf06819d03a0d18adff1fcc2f64182c69274ed0519'
            'ffad4b3657725028bf3250f3555275373b800eacd6b6be5512ef3e5f76563181'
            '39a47d2d12720cc98ee4669e44c012e855df5de0dcec0636f1fb12918c2d8006')

prepare() {
  cd "${_pkgname}-${pkgver}"

  patch -p1 -i ../libwmf-0.2.8.4-libpng-1.5.patch
  patch -p1 -i ../libwmf-0.2.8.4-pngfix.patch

  autoreconf -fi
}

build() {
  local _configure_options=(
    --prefix=/usr

    --enable-shared
    --disable-static
    --disable-debug
    --without-x # WAYLAND
    --with-expat
    --with-freetype
    --with-zlib
    --with-png
    --with-jpeg
    --without-libxml2 # EXPAT
    --disable-gd
    --enable-pixbuf
    --with-gsfontmap=/usr/share/ghostscript/Resource/Init/Fontmap.GS
    --with-gsfontdir=/usr/share/fonts/gsfonts
  )

  cd "${_pkgname}-${pkgver}"
  ./configure "${_configure_options[@]}"
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd "${_pkgname}-${pkgver}"
  make check
}

package() {
  make DESTDIR="${pkgdir}" -C "${_pkgname}-${pkgver}" install
}
