# Contributor: cevdetch

_pkgname=at-spi2-core
pkgname=${_pkgname}-waypure
pkgver=2.62.1
pkgrel=1
pkgdesc="Protocol definitions and daemon for D-Bus at-spi"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/at-spi2-core"
license=('LGPL-2.1-or-later')
depends=('dbus' 'glib2' 'glibc' 'libgcc' 'systemd-libs')
makedepends=('glib2-devel' 'libxml2' 'meson' 'systemd')
provides=("${_pkgname}=${pkgver}" "at-spi2-atk=${pkgver}-${pkgrel}" "atk=${pkgver}-${pkgrel}" 'libatk-1.0.so' 'libatk-bridge-2.0.so' 'libatspi.so')
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("$url/-/archive/$pkgver/at-spi2-core-$pkgver.tar.gz")
sha256sums=('54ac3f44ce3b053b0778e0e6c15357f8c8ff293dad84e1a67d793e02d9f4f4ef')

build() {
  local _meson_options=(
    -Ddefault_bus=dbus-broker
    -Duse_systemd=true
    -Dgtk2_atk_adaptor=false
    -Ddocs=false
    -Dintrospection=disabled
    -Dx11=disabled
    -Datk_only=false
    -Ddbus_glib=disabled
  )

  arch-meson "${_pkgname}-${pkgver}" build "${_meson_options[@]}"

  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}
