--- a/cmake/OpenGLChecks.cmake
+++ b/cmake/OpenGLChecks.cmake
@@ -24,10 +24,23 @@
 # OF THIS SOFTWARE.
 
 # OpenGL and GLUT
-set(OpenGL_GL_PREFERENCE LEGACY)
+set(OpenGL_GL_PREFERENCE GLVND)
 
 find_package(OpenGL COMPONENTS OpenGL)
-find_package(GLUT)
+find_package(FreeGLUT CONFIG QUIET)
+if(TARGET FreeGLUT::freeglut)
+    set(GLUT_FOUND TRUE)
+    set(TIFF_GLUT_TARGET FreeGLUT::freeglut)
+else()
+    find_package(GLUT)
+    set(TIFF_GLUT_TARGET GLUT::GLUT)
+endif()
+
+if(TARGET OpenGL::OpenGL)
+    set(TIFF_OPENGL_TARGET OpenGL::OpenGL)
+else()
+    set(TIFF_OPENGL_TARGET OpenGL::GL)
+endif()
 
 set(OPENGL_SUPPORT FALSE)
 set(HAVE_OPENGL FALSE)
