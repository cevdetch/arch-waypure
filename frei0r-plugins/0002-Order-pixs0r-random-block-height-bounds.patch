Keep independent parameter values while accepting either update order.
std::uniform_int_distribution requires its lower bound not to exceed its upper bound.

--- a/src/filter/pixs0r/pixs0r.cc
+++ b/src/filter/pixs0r/pixs0r.cc
@@ -1,3 +1,4 @@
+#include <algorithm>
 #include <random>
 #include <cstdint>

@@ -79,7 +80,8 @@
         this->m_block_height_min = min_bh;
         this->m_block_height_max = max_bh;

-        auto rng_params = decltype(this->m_block_height_rng)::param_type(min_bh, max_bh);
+        auto rng_params = decltype(this->m_block_height_rng)::param_type(
+            std::min(min_bh, max_bh), std::max(min_bh, max_bh));

         this->m_block_height_rng.param(rng_params);
     }
