# Maintainer: cevdetch (https://github.com/cevdetch)

_pkgname=python-pillow
pkgname=${_pkgname}-waypure
pkgver=13.0.0
pkgrel=1
pkgdesc='Python Imaging Library (PIL) fork'
arch=('x86_64')
url='https://pillow.readthedocs.io'
license=('MIT-CMU')
depends=('glibc' 'python' 'python-packaging' 'freetype2' 'lcms2' 'libavif' 'libraqm' 'libtiff' 'openjpeg2' 'libjpeg-turbo' 'libimagequant' 'zlib')
makedepends=('pybind11' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'libwebp')
checkdepends=('python-pytest' 'python-pytest-timeout')
optdepends=('libwebp: for WebP images'
            'python-olefile: OLE2 file support'
            'python-pyqt6: for the ImageQt module'
            'python-defusedxml: for reading XMP tags'
            'python-numpy: for NumPy array integration'
            'ipython: for notebook image display'
            'grim: for Wayland screenshots'
            'wl-clipboard: for Wayland clipboard images')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
source=("pillow-${pkgver}.tar.gz::https://github.com/python-pillow/Pillow/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('edf59ba26a21ea6d7e6a3755fe139a57297704591c4113ad470dac9ac2ccaf5e')

build() {
  cd "Pillow-${pkgver}"
  local _build_options=(
    --wheel --no-isolation
    -C "parallel=${NPROC:-2}"
    -C xcb=disable
    -C jpeg=enable
    -C zlib=enable
    -C tiff=enable
    -C freetype=enable
    -C raqm=enable
    -C lcms=enable
    -C webp=enable
    -C jpeg2000=enable
    -C imagequant=enable
    -C avif=enable
  )
  python -m build "${_build_options[@]}"
}

check() {
  cd "Pillow-${pkgver}"
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python selftest.py
  test-env/bin/python -m pytest -v
}

package() {
  cd "Pillow-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  local _python_version
  _python_version=$(python -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
  install -Dm644 src/libImaging/*.h -t "${pkgdir}/usr/include/python${_python_version}"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
